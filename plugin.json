{
  "id": "oido-ganalytics",
  "name": "Oido Google Analytics",
  "version": "1.1.0",
  "description": "Query and configure Google Analytics 4 (GA4) properties, reports, realtime data, and admin settings via MCP server.",
  "type": "extension",
  "enabled": true,
  "binary": "oido-ganalytics-mcp",
  "protocol_version": 1,
  "os": ["linux", "darwin"],
  "arch": ["amd64", "arm64"],
  "config_schema": {},
  "capabilities": ["list_properties", "run_report", "realtime_report", "get_metadata", "create_property", "update_property", "manage_data_streams", "manage_custom_dimensions", "manage_custom_metrics", "manage_key_events", "data_retention_settings"],
  "author": "oido-studio",
  "homepage": "https://analytics.google.com"
}
