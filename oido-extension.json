{
  "name": "oido-ganalytics",
  "version": "1.1.0",
  "description": "Query and configure Google Analytics 4 (GA4) — reports, realtime, metadata, plus properties, data streams, custom dimensions/metrics, key events, and data retention — via your own Google OAuth connection.",
  "runtime": "make build",
  "mcpServers": {
    "oido-ganalytics": {
      "command": "${extensionPath}/oido-ganalytics-mcp",
      "args": [],
      "env": {
        "GOOGLE_CLIENT_ID": "${GOOGLE_CLIENT_ID}",
        "GOOGLE_CLIENT_SECRET": "${GOOGLE_CLIENT_SECRET}",
        "GOOGLE_ACCESS_TOKEN": "${GOOGLE_ACCESS_TOKEN}",
        "GOOGLE_OAUTH_EMAIL": "${GOOGLE_OAUTH_EMAIL}"
      }
    }
  },
  "contextFileName": "OIDO.md",
  "excludeTools": [],
  "settings": [
    {
      "name": "GOOGLE_CLIENT_ID",
      "description": "Google OAuth client ID (from your Google Cloud project)",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_CLIENT_SECRET",
      "description": "Google OAuth client secret",
      "defaultValue": "",
      "type": "string",
      "sensitive": true
    },
    {
      "name": "GOOGLE_OAUTH",
      "description": "Connect your Google account for Analytics read + configuration access",
      "type": "oauth2",
      "provider": "google",
      "scopes": [
        "https://www.googleapis.com/auth/analytics.readonly",
        "https://www.googleapis.com/auth/analytics.edit",
        "https://www.googleapis.com/auth/userinfo.email"
      ],
      "clientIdKey": "GOOGLE_CLIENT_ID",
      "clientSecretKey": "GOOGLE_CLIENT_SECRET",
      "tokenKey": "GOOGLE_ACCESS_TOKEN"
    }
  ]
}
